#!/usr/bin/env bash
# desc: Stronger on stylised and low-contrast text. Heavy, slow to start.
# title: EasyOCR
# kind: local
# probe: [[ -x "${EASYOCR_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/easyocr/bin/python}" ]]
# install: easyocr
# confidence: true
# Reads a PNG on stdin, writes recognised text on stdout.
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"

ENGINE_DIR="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/easyocr"
EPY="${EASYOCR_PYTHON:-$ENGINE_DIR/bin/python}"
MODELS="${EASYOCR_MODELS:-$ENGINE_DIR/models}"
IMAGE_MAX_BYTES=52428800
if [[ ! -x "$EPY" ]]; then
  echo "speak: EasyOCR is not installed; add it from the Screen tab." >&2
  notify-send -a "Speak" "EasyOCR not installed" "Add it from the Screen tab." 2>/dev/null
  exit 127
fi

# EasyOCR names languages with two-letter codes; the shared ocr.langs setting
# uses tesseract's three-letter data-file names. Map the common ones so one
# setting drives both engines; anything unmapped is reported, not guessed.
to_easyocr() {
  case "$1" in
    eng) echo en ;; deu) echo de ;; fra) echo fr ;; spa) echo es ;; ita) echo it ;;
    por) echo pt ;; nld) echo nl ;; pol) echo pl ;; rus) echo ru ;; ukr) echo uk ;;
    jpn) echo ja ;; kor) echo ko ;; chi_sim) echo ch_sim ;; chi_tra) echo ch_tra ;;
    ara) echo ar ;; hin) echo hi ;; tur) echo tr ;; vie) echo vi ;; tha) echo th ;;
    swe) echo sv ;; dan) echo da ;; nor) echo no ;; fin) echo 'fi' ;; ces) echo cs ;;
    hun) echo hu ;; ron) echo ro ;; ell) echo el ;; heb) echo he ;; ind) echo id ;;
    *) return 1 ;;
  esac
}

# Which recognition models are actually present. EasyOCR downloads a model on
# first use of a language; that silent network step is refused here, so a
# language is "installed" only when its model file already exists.
if [[ "${1:-}" == "--languages" ]]; then
  jq -nc --arg models "$MODELS" '
    [ ["eng","English","english_g2.pth"], ["deu","German","latin_g2.pth"], ["fra","French","latin_g2.pth"],
      ["spa","Spanish","latin_g2.pth"], ["ita","Italian","latin_g2.pth"], ["por","Portuguese","latin_g2.pth"],
      ["nld","Dutch","latin_g2.pth"], ["pol","Polish","latin_g2.pth"], ["swe","Swedish","latin_g2.pth"],
      ["dan","Danish","latin_g2.pth"], ["nor","Norwegian","latin_g2.pth"], ["fin","Finnish","latin_g2.pth"],
      ["ces","Czech","latin_g2.pth"], ["hun","Hungarian","latin_g2.pth"], ["ron","Romanian","latin_g2.pth"],
      ["tur","Turkish","latin_g2.pth"], ["vie","Vietnamese","latin_g2.pth"], ["ind","Indonesian","latin_g2.pth"],
      ["rus","Russian","cyrillic_g2.pth"], ["ukr","Ukrainian","cyrillic_g2.pth"],
      ["jpn","Japanese","japanese_g2.pth"], ["kor","Korean","korean_g2.pth"],
      ["chi_sim","Chinese (Simplified)","zh_sim_g2.pth"], ["chi_tra","Chinese (Traditional)","zh_tra_g2.pth"],
      ["ara","Arabic","arabic_g2.pth"], ["hin","Hindi","devanagari_g2.pth"], ["tha","Thai","thai_g2.pth"],
      ["ell","Greek","greek_g2.pth"], ["heb","Hebrew","hebrew_g2.pth"] ]
    | map({value: .[0], label: .[1], model: .[2]})' |
  MODELS="$MODELS" "$EPY" -c '
import json, os, sys
models = os.environ.get("MODELS", "")
rows = json.load(sys.stdin)
for r in rows:
    r["installed"] = os.path.exists(os.path.join(models, r.pop("model")))
rows.sort(key=lambda r: (not r["installed"], r["label"].lower()))
print(json.dumps(rows))' 2>/dev/null || printf '[]'
  exit 0
fi

LANGS="${TTS_OCR_LANGS:-}"
[[ -z "$LANGS" ]] && LANGS="$(jq -r '.ocr.easyocr.langs // "eng"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$LANGS" || "$LANGS" == "null" ]] && LANGS="eng"
MINCONF="${TTS_OCR_MINCONF:-$(jq -r '.ocr.minConfidence // 60' "$TTS_CONFIG" 2>/dev/null)}"
[[ "$MINCONF" =~ ^[0-9]+$ && "$MINCONF" -le 100 ]] || MINCONF=60

codes=(); unmapped=""
IFS='+' read -ra requested <<< "$LANGS"
for code in "${requested[@]}"; do
  [[ -z "$code" ]] && continue
  code="${code%_vert}"  # EasyOCR handles orientation itself; vertical variants share the model
  if m="$(to_easyocr "$code")"; then codes+=("$m"); else unmapped+="${unmapped:+, }$code"; fi
done
if [[ -n "$unmapped" ]]; then
  printf 'speak: EasyOCR has no model for: %s (use the tesseract engine for it)\n' "$unmapped" >&2
  notify-send -a "Speak" "OCR language unsupported" "EasyOCR cannot read $unmapped." 2>/dev/null
  exit 78
fi
[[ ${#codes[@]} -gt 0 ]] || codes=(en)

img="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-easyocr.XXXXXX.png")" || exit 1
trap 'rm -f "$img"' EXIT
errlog="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-easyocr.XXXXXX.log")" || exit 1
trap 'rm -f "$img" "$errlog"' EXIT
head -c "$((IMAGE_MAX_BYTES + 1))" > "$img"
[[ "$(stat -c%s "$img" 2>/dev/null || printf 0)" -le "$IMAGE_MAX_BYTES" ]] || {
  printf 'speak: EasyOCR image exceeds the 50 MiB safety limit\n' >&2; exit 65;
}
[[ -s "$img" ]] || { printf 'speak: EasyOCR image is empty\n' >&2; exit 65; }

# Per-box confidence honours the same floor as tesseract, and paragraph mode
# hands the sanitizer reflowed lines rather than one box per word.
LANGS_JSON="$(printf '%s\n' "${codes[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
MINCONF="$MINCONF" MODELS="$MODELS" IMG="$img" \
"$EPY" - <<'PYEOF' 2>"$errlog"
import json, os, sys, warnings
warnings.filterwarnings("ignore")
import easyocr
langs = json.loads(os.environ["LANGS_JSON"])
floor = int(os.environ["MINCONF"]) / 100.0
reader = easyocr.Reader(langs, gpu=False, verbose=False,
                        model_storage_directory=os.environ["MODELS"], download_enabled=False)
kept = []
for box, text, conf in reader.readtext(os.environ["IMG"], paragraph=False, detail=1):
    if conf >= floor and text.strip():
        kept.append((box, text))
# Read in visual order: rows by the box's top edge, then left to right.
kept.sort(key=lambda b: (round(b[0][0][1] / 12), b[0][0][0]))
last_y, out = None, []
for box, text in kept:
    y = round(box[0][1] / 12)
    if last_y is not None and y != last_y:
        out.append("\n")
    elif out:
        out.append(" ")
    out.append(text); last_y = y
sys.stdout.write("".join(out) + ("\n" if out else ""))
PYEOF
rc=$?
# torch is chatty on stderr; surface only the failure line so a broken
# install or a rejected language combination is loud instead of silent.
if [[ $rc -ne 0 ]]; then
  detail="$(grep -E '^[A-Za-z]+Error|^ValueError|^RuntimeError' "$errlog" | tail -n 1)"
  if [[ -n "$detail" ]]; then
    printf 'speak: EasyOCR: %s\n' "$detail" >&2
  else
    printf 'speak: EasyOCR recognition failed (exit %s)\n' "$rc" >&2
  fi
  exit $rc
fi
