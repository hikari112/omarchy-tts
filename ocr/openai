#!/usr/bin/env bash
# desc: opt-in cloud, transcribes screenshots with an OpenAI vision model
# kind: cloud
# probe: [[ -n "${OPENAI_API_KEY:-}" ]] || secret-tool lookup service omarchy-tts key openai >/dev/null 2>&1
# vendor: OpenAI
# keyname: openai
# Reads a PNG on stdin, writes recognised text on stdout.
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"
source "$TTS_PLUGIN_DIR/lib/keys.sh"
source "$TTS_PLUGIN_DIR/lib/cloud.sh"
need curl "install with: omarchy pkg add curl"
KEY="$(get_key OPENAI_API_KEY openai)" || exit 1
MODEL="$(jq -r '.ocr.openai.model // "gpt-4.1-mini"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$MODEL" || "$MODEL" == "null" ]] && MODEL="gpt-4.1-mini"

if [[ "${1:-}" == "--languages" ]]; then
  printf '[{"value":"eng","label":"Any language (model decides)","installed":true}]\n'; exit 0
fi

img="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-ocr.XXXXXX.png")" || exit 1
body="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-ocr-body.XXXXXX")" || exit 1
headers="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-ocr-headers.XXXXXX")" || exit 1
trap 'rm -f "$img" "$body" "$headers"' EXIT
cat > "$img"
b64="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-ocr-b64.XXXXXX")" || exit 1
trap 'rm -f "$img" "$body" "$headers" "$b64"' EXIT
base64 -w0 "$img" > "$b64"

# The image travels through a file, not argv: a full-screen capture exceeds
# the kernel's single-argument limit as base64.
# The instruction asks for a transcription, not a summary, so the model has
# no licence to paraphrase what is on screen.
curl_rc=0
status="$(jq -n --arg m "$MODEL" --rawfile b64 "$b64" '
  {model:$m, temperature:0, max_tokens:2048,
   messages:[{role:"user", content:[
     {type:"text", text:"Transcribe all readable text in this image exactly as written, preserving line breaks and reading order. Output only the text, with no commentary. If there is no text, output nothing."},
     {type:"image_url", image_url:{url:("data:image/png;base64," + ($b64|rtrimstr("\n"))), detail:"high"}}]}]}' |
  curl -sS --connect-timeout 15 --max-time 120 https://api.openai.com/v1/chat/completions \
    -H @/dev/fd/3 --data-binary @- --dump-header "$headers" --output "$body" \
    --write-out '%{http_code}' \
    3<<< "Authorization: Bearer $KEY"$'\nContent-Type: application/json')" || curl_rc=$?
if [[ $curl_rc -ne 0 ]]; then cloud_transport_fail OpenAI "$curl_rc"; exit $?; fi
[[ "$status" =~ ^[0-9]{3}$ ]] || { printf 'OpenAI: invalid HTTP response\n' >&2; exit 74; }
cloud_record openai-ocr "$MODEL" 0 "$status" "$headers" "$body"
if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then cloud_fail OpenAI "$status" "$body" "$headers"; exit $?; fi
jq -r '.choices[0].message.content // empty' "$body" 2>/dev/null ||
  { printf 'OpenAI: unreadable response\n' >&2; exit 74; }
