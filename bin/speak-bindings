#!/usr/bin/env python3
"""Manage the small, explicitly-owned omarchy-tts block in bindings.lua.

The tool never edits bindings outside its markers.  It backs up before every
write and rolls back when Hyprland rejects the result.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
import copy

BEGIN = "-- >>> omarchy-tts bindings"
END = "-- <<< omarchy-tts bindings"
SPEAK = str(Path(__file__).resolve().parent / "speak")
DEFAULTS = {
    "selection": {"chord": "SUPER + ALT + E", "label": "Speak selection", "command": f"{SPEAK} --toggle"},
    "clipboard": {"chord": "SUPER + ALT + A", "label": "Speak clipboard", "command": f"{SPEAK} --clipboard"},
    "stop": {"chord": "SUPER + ALT + X", "label": "Stop speaking", "command": f"{SPEAK} --stop"},
    "snip": {"chord": "SUPER + ALT + R", "label": "Speak screen region", "command": f"{SPEAK} --snip"},
    "window": {"chord": "SUPER + ALT + W", "label": "Speak focused window", "command": f"{SPEAK} --window"},
    "screen": {"chord": "SUPER + ALT + SHIFT + R", "label": "Speak whole screen", "command": f"{SPEAK} --screen"},
}


def paths() -> tuple[Path, Path]:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "hypr" / "bindings.lua", config_home / "omarchy-tts" / "bindings.json"


def load_config(path: Path) -> dict:
    if not path.exists():
        return copy.deepcopy(DEFAULTS)
    try:
        data = json.loads(path.read_text())
        return {key: {**value, **data.get(key, {})} for key, value in DEFAULTS.items()}
    except (OSError, ValueError, TypeError):
        return DEFAULTS


def render(config: dict) -> str:
    lines = [BEGIN, "-- Managed by speak-bindings. Edit through the TTS panel or CLI."]
    for item in config.values():
        chord = item["chord"].replace('"', "")
        label = item["label"].replace('"', "")
        command = item["command"].replace('"', '\\"')
        lines.append(f'o.bind("{chord}", "{label}", "{command}")')
    lines.append(END)
    return "\n".join(lines)


def normalize_chord(chord: str) -> str:
    """Return the canonical Hyprland chord accepted by the QML capture UI."""
    normalized = " + ".join(part.strip().upper() for part in chord.split("+"))
    if not re.fullmatch(r"[A-Z0-9_]+(?: \+ [A-Z0-9_]+)*", normalized):
        raise ValueError("shortcut contains unsupported characters")
    if len(normalized) > 80:
        raise ValueError("shortcut is too long")
    return normalized


def replace_block(text: str, block: str | None) -> str:
    start, end = text.find(BEGIN), text.find(END)
    if (start >= 0) != (end >= 0) or (start >= 0 and end < start):
        raise ValueError("bindings.lua has incomplete omarchy-tts markers")
    if start >= 0:
        end = text.find("\n", end)
        end = len(text) if end < 0 else end + 1
        text = text[:start].rstrip() + "\n" + text[end:].lstrip("\n")
    if block:
        text = text.rstrip() + "\n\n" + block + "\n"
    return text


# Flags only this tool's CLI accepts. A binding that runs a program called
# "speak" with one of these is ours however it was written - by hand, by an
# older README, through ~/.local/bin, or straight out of the plugin directory.
OUR_FLAGS = {"--toggle", "--clipboard", "--stop", "--snip", "--window",
             "--screen", "--selection"}
BIND_LINE = re.compile(r'\bo\.bind\(\s*"[^"]*"\s*,\s*"[^"]*"\s*,\s*"([^"]*)"')


def is_our_command(command: str) -> bool:
    """True when this command line invokes our speak CLI.

    Deliberately strict: the executable must be named `speak` and must carry
    one of our own flags, so an unrelated binding is never adopted or removed.
    """
    parts = command.split()
    if not parts:
        return False
    if Path(parts[0]).name != "speak":
        return False
    return any(part in OUR_FLAGS for part in parts[1:])


def adoptable_bindings(text: str) -> list[str]:
    """Chords bound to our CLI outside the managed block."""
    found = []
    for line in text.splitlines():
        match = BIND_LINE.search(line)
        if match and is_our_command(match.group(1)):
            chord = re.search(r'o\.bind\(\s*"([^"]*)"', line)
            if chord:
                found.append(chord.group(1))
    return found


def migrate_manual_tts_lines(text: str) -> str:
    """Drop bindings that invoke our CLI, so they can be re-added as a block."""
    kept = []
    for line in text.splitlines():
        match = BIND_LINE.search(line)
        if match and is_our_command(match.group(1)):
            continue
        kept.append(line)
    return "\n".join(kept).rstrip() + "\n"


def conflicting_chords(text: str, config: dict) -> list[str]:
    conflicts = []
    for item in config.values():
        chord = item["chord"]
        if re.search(r'(?:o|hl)\.bind\(\s*["\']' + re.escape(chord) + r'["\']', text, re.I):
            conflicts.append(chord)
    return conflicts


def validate_or_restore(target: Path, backup: Path) -> None:
    if shutil.which("hyprctl") is None or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    reload_result = subprocess.run(["hyprctl", "reload"], capture_output=True, text=True)
    errors = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True)
    if reload_result.returncode or errors.stdout.strip():
        shutil.copy2(backup, target)
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        message = errors.stdout.strip() or reload_result.stderr.strip() or "Hyprland rejected the file"
        raise RuntimeError(message)


def write(target: Path, content: str) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        target.write_text("-- Personal keybindings\n")
    backup = target.with_name(f"{target.name}.tts.bak.{int(time.time())}")
    shutil.copy2(target, backup)
    temporary = target.with_suffix(".lua.tts.tmp")
    temporary.write_text(content)
    os.replace(temporary, target)
    validate_or_restore(target, backup)


def save_config(path: Path, config: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(config, indent=2) + "\n")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    sub.add_parser("install")
    sub.add_parser("remove")
    set_parser = sub.add_parser("set")
    set_parser.add_argument("action", choices=DEFAULTS)
    set_parser.add_argument("chord")
    args = parser.parse_args()
    target, config_path = paths()
    config = load_config(config_path)
    full_text = target.read_text(errors="replace") if target.exists() else "-- Personal keybindings\n"
    without_block = replace_block(full_text, None)

    if args.command == "status":
        installed = BEGIN in full_text
        # Exact shortcuts from older README versions are safe to adopt into
        # our managed block; do not present them as user conflicts.
        conflict_source = without_block if installed else migrate_manual_tts_lines(without_block)
        conflicts = conflicting_chords(conflict_source, config)
        adoptable = [] if installed else adoptable_bindings(without_block)
        print(json.dumps({"installed": installed, "bindings": config,
                          "conflicts": conflicts, "adoptable": adoptable,
                          "canInstall": not conflicts}))
        return 0
    if args.command == "set":
        candidate = copy.deepcopy(config)
        candidate[args.action]["chord"] = normalize_chord(args.chord)
        conflicts = conflicting_chords(without_block, candidate)
        if conflicts:
            raise ValueError("shortcut already used: " + ", ".join(conflicts))
        block = render(candidate) if BEGIN in full_text else None
        if block:
            write(target, replace_block(without_block, block))
        save_config(config_path, candidate)
        print("updated")
        return 0
    original = without_block
    if args.command == "install":
        original = migrate_manual_tts_lines(original)
    block = None if args.command == "remove" else render(config)
    conflicts = conflicting_chords(original, config) if block else []
    if conflicts:
        raise ValueError("shortcut already used outside the TTS block: " + ", ".join(conflicts))
    write(target, replace_block(original, block))
    print("removed" if block is None else "installed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"speak-bindings: {exc}", file=sys.stderr)
        raise SystemExit(1)
