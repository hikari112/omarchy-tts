#!/usr/bin/env bash
# speak-voice - manage local piper voice models.
set -uo pipefail

VOICES_DIR="${PIPER_VOICES_DIR:-$HOME/.local/share/piper-voices}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tts/config.json"
PIPER_PY="$HOME/.local/share/uv/tools/piper-tts/bin/python"
mkdir -p "$VOICES_DIR"

usage() {
  cat <<'USAGE'
Usage: speak-voice <command>

  list                installed voices (* = active)
  add <voice>         download a voice, e.g. en_GB-alba-medium
  remove <voice>      delete a downloaded voice
  use <voice>         make a voice the default
  browse              open the voice catalogue in your browser

Voice names look like <lang>-<name>-<quality>, e.g. en_US-amy-medium.
USAGE
}

active_voice() { jq -r '.piper.voice // "en_US-amy-medium"' "$CONFIG" 2>/dev/null; }

case "${1:-}" in
  list)
    act="$(active_voice)"
    found=0
    for m in "$VOICES_DIR"/*.onnx; do
      [[ -e "$m" ]] || continue
      found=1
      n="$(basename "$m" .onnx)"
      mark="  "; [[ "$n" == "$act" ]] && mark="* "
      sz="$(du -h "$m" | cut -f1)"
      printf '%s%-28s %s\n' "$mark" "$n" "$sz"
    done
    [[ $found -eq 0 ]] && echo "No voices installed. Try: speak-voice add en_US-amy-medium"
    ;;
  add)
    [[ -n "${2:-}" ]] || { echo "speak-voice: need a voice name" >&2; exit 1; }
    [[ -x "$PIPER_PY" ]] || { echo "speak-voice: piper not installed (uv tool install piper-tts)" >&2; exit 1; }
    echo "Downloading $2 ..."
    (cd "$VOICES_DIR" && "$PIPER_PY" -m piper.download_voices "$2") || exit 1
    echo "Installed. Use it with: speak-voice use $2"
    ;;
  remove)
    [[ -n "${2:-}" ]] || { echo "speak-voice: need a voice name" >&2; exit 1; }
    rm -f "$VOICES_DIR/$2.onnx" "$VOICES_DIR/$2.onnx.json" && echo "Removed $2"
    ;;
  use)
    [[ -n "${2:-}" ]] || { echo "speak-voice: need a voice name" >&2; exit 1; }
    [[ -f "$VOICES_DIR/$2.onnx" ]] || { echo "speak-voice: not installed: $2" >&2; exit 1; }
    tmp="$(mktemp)"
    jq --arg v "$2" '.piper.voice = $v' "$CONFIG" > "$tmp" && mv "$tmp" "$CONFIG"
    echo "Default voice is now $2"
    ;;
  browse) xdg-open "https://rhasspy.github.io/piper-samples/" 2>/dev/null & ;;
  *) usage ;;
esac
