#!/usr/bin/env bash
# speak-voice - browse, download and switch local voice models.
set -uo pipefail

VOICES_DIR="${PIPER_VOICES_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tts/voices/piper}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tts/config.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-tts"
CATALOGUE="$CACHE_DIR/voices.json"
STATE_DIR="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/omarchy-tts}"
# Without a session runtime dir, fall back to an owner-only XDG state
# directory rather than sticky /tmp, so runtime PID state is never in a
# location another user can pre-populate.
STATE_DIR="${STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-tts/run}"
DL_STATE="$STATE_DIR/download.json"
DL_LOCK="$STATE_DIR/download.lock"
OWNER_PID=""

CATALOGUE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main/voices.json?download=true"
FILE_BASE="https://huggingface.co/rhasspy/piper-voices/resolve/main"
CACHE_MAX_AGE_DAYS=7

mkdir -p "$VOICES_DIR" "$CACHE_DIR"
[[ ! -L "$STATE_DIR" ]] || {
  printf 'speak-voice: unsafe runtime directory symlink: %s\n' "$STATE_DIR" >&2; exit 1;
}
mkdir -p "$STATE_DIR"
[[ ! -L "$STATE_DIR" && "$(stat -c %u "$STATE_DIR" 2>/dev/null)" == "$UID" ]] || {
  printf 'speak-voice: unsafe runtime directory: %s\n' "$STATE_DIR" >&2; exit 1;
}
chmod 700 "$STATE_DIR" || exit 1

# Voices used to live in ~/.local/share/piper-voices. The player still reads
# that path, so those voices work - but this tool never scanned it, so they
# showed as available to download and could not be removed at all. Move them
# into the canonical directory once, so there is a single answer to "what is
# installed".
migrate_legacy_voices() {
  local legacy="$HOME/.local/share/piper-voices"
  [[ -d "$legacy" ]] || return 0
  [[ "$(readlink -f "$legacy")" != "$(readlink -f "$VOICES_DIR")" ]] || return 0
  local model name
  for model in "$legacy"/*.onnx; do
    [[ -e "$model" ]] || continue
    name="$(basename "$model")"
    [[ -e "$VOICES_DIR/$name" ]] && continue
    mv -n "$model" "$VOICES_DIR/$name" 2>/dev/null || continue
    [[ -e "$legacy/$name.json" ]] && mv -n "$legacy/$name.json" "$VOICES_DIR/$name.json" 2>/dev/null
  done
  rmdir "$legacy" 2>/dev/null || true
}
migrate_legacy_voices

PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_DIR/lib/config.sh"
tts_config_init || { printf 'speak-voice: could not initialize %s\n' "$CONFIG" >&2; exit 1; }

die() { printf 'speak-voice: %s\n' "$*" >&2; exit 1; }

process_identity() { # process_identity <pid> -> Linux start-time field
  local pid="$1" stat_line rest
  local -a fields
  [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || return 1
  IFS= read -r stat_line 2>/dev/null < "/proc/$pid/stat" || return 1
  rest="${stat_line##*) }"
  read -r -a fields <<< "$rest"
  [[ "${fields[19]:-}" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${fields[19]}"
}

terminate_download_worker() { # terminate_download_worker <pid> <identity>
  local pid="$1" identity="$2" current=""
  kill -TERM -- "-$pid" 2>/dev/null || true
  # This is a child of the launcher, so wait for its trap to finish cleanup.
  # Recheck the start identity before escalating in case the numeric PID was
  # somehow reused after the child exited.
  for _ in {1..100}; do
    current="$(process_identity "$pid" || true)"
    [[ -z "$current" || "$current" != "$identity" ]] && break
    sleep 0.01
  done
  current="$(process_identity "$pid" || true)"
  if [[ -n "$identity" && "$current" == "$identity" ]]; then
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
}

usage() {
  cat <<'USAGE'
Usage: speak-voice <command>

  list                    installed voices (* = active)
  available [--json]      every downloadable voice
  add <voice> [--async]   download a voice
  remove <voice>          delete a downloaded voice
  use <voice>             make a voice the default
  status [--json]         progress of a download in flight
  cancel                  cancel the active download
  refresh                 re-fetch the voice catalogue
  browse                  open the sample page in a browser

Voice names look like <lang>-<name>-<quality>, e.g. en_US-amy-medium.
USAGE
}

active_voice() { jq -r '.piper.voice // "en_US-amy-medium"' "$CONFIG" 2>/dev/null; }

is_installed() { [[ -f "$VOICES_DIR/$1.onnx" ]]; }

# The catalogue is 240K and changes rarely; refetch only when stale or absent.
ensure_catalogue() {
  local force="${1:-no}" stale=1
  if [[ "$force" != yes && -s "$CATALOGUE" ]]; then
    if [[ -z "$(find "$CATALOGUE" -mtime +$CACHE_MAX_AGE_DAYS 2>/dev/null)" ]]; then stale=0; fi
  fi
  [[ $stale -eq 0 ]] && return 0
  if ! command -v curl >/dev/null 2>&1; then
    [[ -s "$CATALOGUE" && "$force" != yes ]]
    return
  fi
  local tmp; tmp="$(mktemp "${CATALOGUE}.XXXXXX")" || return 1
  if curl -sL --fail --max-time 30 "$CATALOGUE_URL" -o "$tmp" &&
      jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$CATALOGUE"; return 0
  fi
  rm -f "$tmp"
  # A stale catalogue still beats none at all.
  if [[ -s "$CATALOGUE" && "$force" != yes ]]; then return 0; fi
  return 1
}

write_state() { # write_state <status> <voice> <got> <total> [message]
  local pid="${OWNER_PID:-0}" identity="" tmp
  [[ "$pid" -gt 1 ]] && identity="$(process_identity "$pid" || true)"
  tmp="$(mktemp "${DL_STATE}.XXXXXX")" || return 1
  jq -nc --arg s "$1" --arg v "$2" --argjson g "${3:-0}" --argjson t "${4:-0}" \
        --arg m "${5:-}" \
        --argjson pid "$pid" --arg identity "$identity" \
        '{status:$s, voice:$v, bytes:$g, total:$t, message:$m,
          pid:$pid, processIdentity:$identity,
          percent: (if $t > 0 then (($g / $t) * 100 | floor) else 0 end)}' \
    > "$tmp" 2>/dev/null && mv "$tmp" "$DL_STATE"
}

emit_available() {
  ensure_catalogue || die "could not fetch the voice catalogue (offline?)"
  local installed; installed="$(
    for m in "$VOICES_DIR"/*.onnx; do [[ -e "$m" ]] && basename "$m" .onnx; done |
      jq -Rsc 'split("\n") | map(select(length > 0))'
  )"
  jq -c --argjson inst "$installed" '
    to_entries
    | map({
        key: .key,
        name: .value.name,
        lang: .value.language.name_english,
        country: (.value.language.country_english // ""),
        code: .value.language.code,
        quality: .value.quality,
        sizeMB: ((( [.value.files | to_entries[] | select(.key | endswith(".onnx")) | .value.size_bytes ][0] // 0) / 1048576) | floor),
        installed: (.key as $k | $inst | index($k) != null)
      })
    | sort_by((.installed | not), .lang, .name, .quality)
  ' "$CATALOGUE"
}

file_meta() { # file_meta <voice> <suffix> -> "path<TAB>size<TAB>md5"
  jq -r --arg k "$1" --arg sfx "$2" '
    .[$k].files | to_entries[] | select(.key | endswith($sfx))
    | "\(.key)\t\(.value.size_bytes)\t\(.value.md5_digest)"
  ' "$CATALOGUE" 2>/dev/null | head -1
}

fetch_file() { # fetch_file <repo-path> <dest> <expected-size> <md5> <voice> <report>
  local path="$1" dest="$2" size="$3" md5="$4" voice="$5" report="$6"
  local part="$dest.part" poller=""
  rm -f "$part"
  if [[ "$report" == "yes" ]]; then
    ( while :; do
        local got; got="$(stat -c%s "$part" 2>/dev/null || echo 0)"
        write_state downloading "$voice" "$got" "$size"
        sleep 0.4
      done ) & poller=$!
  fi
  local rc=0
  curl -sL --fail --retry 2 --connect-timeout 15 --max-time 900 \
    "$FILE_BASE/$path?download=true" -o "$part" || rc=$?
  if [[ -n "$poller" ]]; then
    kill "$poller" 2>/dev/null
    wait "$poller" 2>/dev/null || true
  fi
  if [[ $rc -ne 0 ]]; then rm -f "$part"; return 1; fi
  if [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 ]]; then
    local got_size; got_size="$(stat -c%s "$part" 2>/dev/null || echo 0)"
    [[ "$got_size" == "$size" ]] || { rm -f "$part"; return 2; }
  fi
  if [[ -n "$md5" && "$md5" != "null" ]] && command -v md5sum >/dev/null 2>&1; then
    local got_md5; got_md5="$(md5sum "$part" | cut -d' ' -f1)"
    [[ "$got_md5" == "$md5" ]] || { rm -f "$part"; return 2; }
  fi
  mv "$part" "$dest"
}

do_add() { # do_add <voice> <report>
  local voice="$1" report="${2:-no}"
  ensure_catalogue || { [[ "$report" == yes ]] && write_state error "$voice" 0 0 "no catalogue"; return 1; }
  jq -e --arg k "$voice" 'has($k)' "$CATALOGUE" >/dev/null 2>&1 ||
    { [[ "$report" == yes ]] && write_state error "$voice" 0 0 "no such voice"; return 1; }

  # Re-running add is an idempotent repair operation. Never replace a working
  # model merely to fill in its small metadata sidecar.
  if is_installed "$voice"; then
    local existing_meta existing_path existing_size existing_digest
    existing_meta="$(file_meta "$voice" ".onnx.json")"
    IFS=$'\t' read -r existing_path existing_size existing_digest <<< "$existing_meta"
    if [[ ! -f "$VOICES_DIR/$voice.onnx.json" && -n "$existing_path" ]]; then
      fetch_file "$existing_path" "$VOICES_DIR/$voice.onnx.json" \
        "$existing_size" "$existing_digest" "$voice" no || return 1
    fi
    [[ "$report" == yes ]] && write_state "done" "$voice" 1 1 "Already installed"
    return 0
  fi

  local m p s d
  m="$(file_meta "$voice" ".onnx")"
  IFS=$'\t' read -r p s d <<< "$m"
  [[ -n "$p" ]] || { [[ "$report" == yes ]] && write_state error "$voice" 0 0 "no model file"; return 1; }

  [[ "$report" == yes ]] && write_state downloading "$voice" 0 "$s"
  if ! fetch_file "$p" "$VOICES_DIR/$voice.onnx" "$s" "$d" "$voice" "$report"; then
    [[ "$report" == yes ]] && write_state error "$voice" 0 "$s" "download failed"
    return 1
  fi

  local mj pj sj dj
  mj="$(file_meta "$voice" ".onnx.json")"
  IFS=$'\t' read -r pj sj dj <<< "$mj"
  if [[ -n "$pj" ]]; then
    fetch_file "$pj" "$VOICES_DIR/$voice.onnx.json" "$sj" "$dj" "$voice" no || {
      rm -f "$VOICES_DIR/$voice.onnx"
      [[ "$report" == yes ]] && write_state error "$voice" 0 "$s" "config download failed"
      return 1
    }
  fi
  [[ "$report" == yes ]] && write_state "done" "$voice" "$s" "$s"
  return 0
}

case "${1:-}" in
  list)
    act="$(active_voice)"; found=0
    for m in "$VOICES_DIR"/*.onnx; do
      [[ -e "$m" ]] || continue
      found=1; n="$(basename "$m" .onnx)"
      mark="  "; [[ "$n" == "$act" ]] && mark="* "
      printf '%s%-28s %s\n' "$mark" "$n" "$(du -h "$m" | cut -f1)"
    done
    [[ $found -eq 0 ]] && echo "No voices installed. Try: speak-voice add en_US-amy-medium"
    ;;
  available)
    if [[ "${2:-}" == "--json" ]]; then
      emit_available
    else
      emit_available | jq -r '.[] | "\(if .installed then "*" else " " end) \(.key)  \(.lang)  \(.quality)  \(.sizeMB)MB"'
    fi
    ;;
  add)
    [[ -n "${2:-}" ]] || die "need a voice name"
    [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid voice name"
    if [[ "${3:-}" == "--async" ]]; then
      exec {download_lock_fd}>"$DL_LOCK"
      flock -n "$download_lock_fd" || die "a voice download is already running"
      write_state starting "$2" 0 0 "Preparing download" || die "could not write download state"
      setsid "$0" _download "$2" >/dev/null 2>&1 &
      download_pid=$!
      download_identity="$(process_identity "$download_pid" || true)"
      exec {download_lock_fd}>&-
      download_registered=0
      for _ in {1..200}; do
        state_pid="$(jq -r '.pid // 0' "$DL_STATE" 2>/dev/null)"
        state_identity="$(jq -r '.processIdentity // ""' "$DL_STATE" 2>/dev/null)"
        if [[ "$state_pid" == "$download_pid" && -n "$state_identity" ]]; then
          download_registered=1
          break
        fi
        kill -0 "$download_pid" 2>/dev/null || break
        sleep 0.01
      done
      if [[ $download_registered -ne 1 ]]; then
        terminate_download_worker "$download_pid" "$download_identity"
        write_state error "$2" 0 0 "Download worker did not initialize safely"
        die "download could not start safely"
      fi
      echo "started"
    else
      exec {download_lock_fd}>"$DL_LOCK"
      flock -n "$download_lock_fd" || die "a voice download is already running"
      echo "Downloading $2 ..."
      do_add "$2" no || die "download failed"
      echo "Installed. Use it with: speak-voice use $2"
      exec {download_lock_fd}>&-
    fi
    ;;
  _download)
    download_voice="${2:-}"
    [[ "$download_voice" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid voice name"
    OWNER_PID=$BASHPID
    export OWNER_PID
    download_was_installed=0
    is_installed "$download_voice" && download_was_installed=1
    # Invoked indirectly by the TERM/INT trap below.
    # shellcheck disable=SC2329
    cancel_download_worker() {
      rm -f "$VOICES_DIR/$download_voice.onnx.part" \
        "$VOICES_DIR/$download_voice.onnx.json.part"
      # A model and its sidecar are one installation. Preserve an existing
      # model being repaired, but roll back every final file created for a new
      # install if cancellation lands between the two atomic downloads.
      if [[ $download_was_installed -eq 0 ]]; then
        rm -f "$VOICES_DIR/$download_voice.onnx" \
          "$VOICES_DIR/$download_voice.onnx.json"
      fi
      write_state cancelled "$download_voice" 0 0 "Cancelled"
      exit 143
    }
    trap cancel_download_worker TERM INT
    write_state starting "$download_voice" 0 0 "Preparing download" || exit 1
    do_add "$download_voice" yes
    download_rc=$?
    trap - TERM INT
    exit "$download_rc" ;;
  status)
    if [[ -s "$DL_STATE" ]]; then
      if ! jq -e 'type == "object"' "$DL_STATE" >/dev/null 2>&1; then
        write_state error "" 0 0 "Download state was unreadable; try again"
        cat "$DL_STATE"
      else
        state_status="$(jq -r '.status // "idle"' "$DL_STATE")"
        state_pid="$(jq -r '.pid // 0' "$DL_STATE")"
        state_identity="$(jq -r '.processIdentity // ""' "$DL_STATE")"
        if [[ "$state_status" == starting || "$state_status" == downloading ]]; then
          current_identity="$(process_identity "$state_pid" || true)"
          if [[ -z "$state_identity" || "$state_identity" != "$current_identity" ]]; then
            state_voice="$(jq -r '.voice // ""' "$DL_STATE")"
            write_state error "$state_voice" 0 0 "Download stopped unexpectedly"
            cat "$DL_STATE"
          else
            cat "$DL_STATE"
          fi
        else
          cat "$DL_STATE"
        fi
      fi
    else echo '{"status":"idle","voice":"","bytes":0,"total":0,"percent":0,"message":""}'; fi
    ;;
  cancel)
    state_status="$(jq -r '.status // "idle"' "$DL_STATE" 2>/dev/null)"
    pid="$(jq -r '.pid // 0' "$DL_STATE" 2>/dev/null)"
    identity="$(jq -r '.processIdentity // ""' "$DL_STATE" 2>/dev/null)"
    current="$(process_identity "$pid" || true)"
    if [[ "$state_status" == starting || "$state_status" == downloading ]] &&
        [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 && -n "$identity" && "$identity" == "$current" ]] &&
        kill -TERM -- "-$pid" 2>/dev/null; then
      for _ in {1..200}; do
        current="$(process_identity "$pid" || true)"
        [[ -z "$current" || "$current" != "$identity" ]] && break
        sleep 0.01
      done
    else
      die "no active voice download"
    fi
    current="$(process_identity "$pid" || true)"
    final_status="$(jq -r '.status // "idle"' "$DL_STATE" 2>/dev/null)"
    # Completion can win the race with Cancel after the state was inspected.
    # Keep the truthful terminal result and the fully verified installation.
    [[ "$final_status" == "done" ]] && exit 0
    [[ -z "$current" || "$current" != "$identity" || "$final_status" == cancelled ]] ||
      die "voice download did not stop; try again"
    cancelled_voice="$(jq -r '.voice // ""' "$DL_STATE" 2>/dev/null)"
    [[ "$cancelled_voice" =~ ^[A-Za-z0-9._-]+$ ]] &&
      rm -f "$VOICES_DIR/$cancelled_voice.onnx.part" "$VOICES_DIR/$cancelled_voice.onnx.json.part"
    [[ "$final_status" == cancelled ]] ||
      write_state cancelled "$cancelled_voice" 0 0 "Cancelled"
    ;;
  remove)
    [[ -n "${2:-}" ]] || die "need a voice name"
    [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid voice name"
    [[ "$2" != "$(active_voice)" || "${3:-}" == "--force" ]] || die "choose another active voice before removing $2"
    rm -f "$VOICES_DIR/$2.onnx" "$VOICES_DIR/$2.onnx.json" && echo "Removed $2"
    ;;
  use)
    [[ -n "${2:-}" ]] || die "need a voice name"
    is_installed "$2" || die "not installed: $2"
    tts_config_set .piper.voice "$2" || die "could not update configuration"
    echo "Default voice is now $2"
    ;;
  refresh)
    ensure_catalogue yes || die "could not refresh the voice catalogue; existing cache was kept"
    echo "Catalogue refreshed ($(jq 'length' "$CATALOGUE") voices)" ;;
  browse) xdg-open "https://rhasspy.github.io/piper-samples/" 2>/dev/null & ;;
  *) usage ;;
esac
