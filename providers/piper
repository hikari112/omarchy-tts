#!/usr/bin/env bash
# desc: Fast, natural, runs here. The default.
# title: Piper
# kind: local
# probe: ([[ -x "${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/piper/bin/piper" ]] || command -v piper >/dev/null) && (for model in "${PIPER_VOICES_DIR:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/voices/piper}"/*.onnx "$HOME/.local/share/piper-voices"/*.onnx; do [[ -s "$model" && -s "$model.json" ]] && exit 0; done; exit 1)
# install: managed venv · piper-tts==1.7.0
# voices: downloadable
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"
PIPER_BIN="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/piper/bin/piper"
[[ -x "$PIPER_BIN" ]] || PIPER_BIN="$(command -v piper || true)"
[[ -n "$PIPER_BIN" ]] || need piper "install it from the Provider tab"

VOICES_DIR="${PIPER_VOICES_DIR:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/voices/piper}"
# Voice model and sidecar are a single installation. Hold a shared lock while
# Piper reads/uses them so repair/removal cannot expose a mixed pair.
VOICE_STATE_DIR="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/omarchy-tts}"
VOICE_STATE_DIR="${VOICE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-tts/run}"
[[ ! -L "$VOICE_STATE_DIR" ]] || {
  printf 'speak: unsafe Piper runtime directory symlink: %s\n' "$VOICE_STATE_DIR" >&2
  exit 1
}
mkdir -p "$VOICE_STATE_DIR" || exit 1
[[ ! -L "$VOICE_STATE_DIR" && "$(stat -c %u "$VOICE_STATE_DIR" 2>/dev/null)" == "$UID" ]] || {
  printf 'speak: unsafe Piper runtime directory: %s\n' "$VOICE_STATE_DIR" >&2
  exit 1
}
chmod 700 "$VOICE_STATE_DIR" || exit 1
exec {voice_lock_fd}>>"$VOICE_STATE_DIR/voice-files.lock" || exit 1
flock -s "$voice_lock_fd" || exit 1
VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.piper.voice // "en_US-amy-medium"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="en_US-amy-medium"

if [[ -f "$VOICE" ]]; then MODEL="$VOICE"; else MODEL="$VOICES_DIR/$VOICE.onnx"; fi
[[ -f "$MODEL" ]] || MODEL="$HOME/.local/share/piper-voices/$VOICE.onnx"

if [[ ! -s "$MODEL" || ! -s "$MODEL.json" ]]; then
  echo "speak: piper voice not found: $MODEL" >&2
  notify-send -a "Speak" "Voice missing or incomplete" "Repair it: speak-voice add $VOICE --repair" 2>/dev/null
  exit 1
fi

# A voice the plugin ships a digest for is verified right before Piper loads
# it, the same way the other engines verify their models. Voices outside the
# shipped catalogue (custom or legacy) are the user's own and get only the
# structural checks above.
DIGESTS="$TTS_PLUGIN_DIR/lib/piper-voices.sha256"
if [[ "$MODEL" == "$VOICES_DIR/$VOICE.onnx" && -f "$DIGESTS" && "$VOICE" =~ ^[A-Za-z0-9._-]+$ ]]; then
  for suffix in .onnx .onnx.json; do
    want="$(awk -v v="/$VOICE$suffix" '$1 !~ /^#/ && substr($2, length($2)-length(v)+1) == v { print tolower($1); exit }' "$DIGESTS" 2>/dev/null)"
    [[ -n "$want" ]] || continue   # not a catalogue voice
    [[ ! -L "$MODEL${suffix#.onnx}" ]] || { echo "speak: piper voice $VOICE$suffix is a symlink; repair it: speak-voice add $VOICE --repair" >&2; exit 65; }
    got="$(sha256sum "$VOICES_DIR/$VOICE$suffix" | cut -d' ' -f1)"
    [[ "$got" == "$want" ]] || {
      echo "speak: piper voice $VOICE$suffix failed verification; repair it: speak-voice add $VOICE --repair" >&2
      notify-send -a "Speak" "Voice failed verification" "Repair it: speak-voice add $VOICE --repair" 2>/dev/null
      exit 65
    }
  done
fi

# Model config carries the real sample rate; guessing here causes chipmunks.
RATE_HZ="$(jq -r '.audio.sample_rate // 22050' "$MODEL.json" 2>/dev/null)"
[[ "$RATE_HZ" =~ ^[0-9]+$ ]] || RATE_HZ=22050

# length-scale is inverse speed: 0.5 = twice as fast.
LEN="$(awk -v r="${TTS_RATE:-1.0}" 'BEGIN{ if (r<=0) r=1; printf "%.3f", 1/r }')"

"$PIPER_BIN" -m "$MODEL" --output-raw --length-scale "$LEN" 2>/dev/null | play_raw "$RATE_HZ" 1
