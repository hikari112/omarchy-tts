#!/usr/bin/env bash
# desc: compatibility provider; robotic but instant and tiny
# kind: local
# probe: command -v espeak-ng >/dev/null 2>&1
# install: omarchy pkg add espeak-ng
# voices: system
# deprecated: true
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"
need espeak-ng "install with: omarchy pkg add espeak-ng"

WPM="$(awk -v r="${TTS_RATE:-1.0}" 'BEGIN{ if (r<=0) r=1; printf "%d", 175*r }')"
VOICE="${TTS_VOICE:-en-us}"
if [[ "${TTS_SILENT:-0}" == "1" ]]; then
  exec espeak-ng -s "$WPM" -v "$VOICE" --stdout --stdin >/dev/null
fi
exec espeak-ng -s "$WPM" -v "$VOICE" --stdin
