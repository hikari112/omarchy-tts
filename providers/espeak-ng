#!/usr/bin/env bash
# desc: robotic but instant, tiny, never fails
# kind: local
# probe: command -v espeak-ng >/dev/null 2>&1
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"
need espeak-ng "install with: omarchy pkg add espeak-ng"

WPM="$(awk -v r="${TTS_RATE:-1.0}" 'BEGIN{ if (r<=0) r=1; printf "%d", 175*r }')"
VOICE="${TTS_VOICE:-en-us}"
exec espeak-ng -s "$WPM" -v "$VOICE" --stdin
