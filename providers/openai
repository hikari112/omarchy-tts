#!/usr/bin/env bash
# desc: opt-in cloud, needs OPENAI_API_KEY, text leaves your machine
# kind: cloud
# probe: [[ -n "${OPENAI_API_KEY:-}" ]] || secret-tool lookup service omarchy-tts key openai >/dev/null 2>&1
# vendor: OpenAI
# voices: remote
# maxchars: 4096
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"
source "$TTS_PLUGIN_DIR/lib/keys.sh"
source "$TTS_PLUGIN_DIR/lib/cloud.sh"
need curl "install with: omarchy pkg add curl"
KEY="$(get_key OPENAI_API_KEY openai)" || exit 1

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.openai.voice // "alloy"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="alloy"
MODEL="$(jq -r '.openai.model // "gpt-4o-mini-tts"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$MODEL" || "$MODEL" == "null" ]] && MODEL="gpt-4o-mini-tts"

if [[ "${1:-}" == "--usage" ]]; then
  jq -c '. + {account:{source:"request_headers",note:"OpenAI account-wide usage requires an organization admin key; request limits update after each speech request."}}' \
    "${TTS_METRICS_FILE:-/dev/null}" 2>/dev/null ||
    jq -nc --arg model "$MODEL" '{provider:"openai",model:$model,account:{source:"request_headers",note:"Rate limits appear after the first speech request."}}'
  exit 0
fi

audio="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-openai.XXXXXX.mp3")" || exit 1
headers="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-openai-headers.XXXXXX")" || exit 1
trap 'rm -f "$audio" "$headers"' EXIT
status="$(jq -Rs --arg m "$MODEL" --arg v "$VOICE" --argjson s "${TTS_RATE:-1.0}" \
  '{model:$m, voice:$v, input:., speed:$s, response_format:"mp3"}' |
  curl -sS --connect-timeout 15 --max-time 180 \
    https://api.openai.com/v1/audio/speech \
    -H @/dev/fd/3 --data-binary @- --dump-header "$headers" --output "$audio" \
    --write-out '%{http_code}' \
    3<<< "Authorization: Bearer $KEY"$'\nContent-Type: application/json')" || exit $?
[[ -n "$status" ]] || status=200 # permits simple curl fakes used by downstream tests
cloud_record openai "$MODEL" "${TTS_INPUT_CHARS:-0}" "$status" "$headers" "$audio"
if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then cloud_fail OpenAI "$status" "$audio" "$headers"; exit $?; fi
play_file "$audio"
