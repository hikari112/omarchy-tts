#!/usr/bin/env bash
# desc: opt-in cloud, needs ELEVENLABS_API_KEY, text leaves your machine
# kind: cloud
# probe: [[ -n "${ELEVENLABS_API_KEY:-}" ]] || secret-tool lookup service omarchy-tts key elevenlabs >/dev/null 2>&1
# vendor: ElevenLabs
# voices: remote
# maxchars: 40000
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"
source "$TTS_PLUGIN_DIR/lib/keys.sh"
source "$TTS_PLUGIN_DIR/lib/cloud.sh"
need curl "install with: omarchy pkg add curl"
KEY="$(get_key ELEVENLABS_API_KEY elevenlabs)" || exit 1

MODEL="$(jq -r '.elevenlabs.model // "eleven_turbo_v2_5"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$MODEL" || "$MODEL" == "null" ]] && MODEL="eleven_turbo_v2_5"

# List the account's voices as {value,label} pairs. ElevenLabs addresses
# voices by opaque id, so without this the panel can only ever show the one id
# already in the config, and shows it as the identifier it is.
if [[ "${1:-}" == "--voices" ]]; then
  body="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-voices.XXXXXX")" || exit 1
  aggregate="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-all-voices.XXXXXX")" || {
    rm -f "$body"; exit 1; }
  next="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-next-voices.XXXXXX")" || {
    rm -f "$body" "$aggregate"; exit 1; }
  trap 'rm -f "$body" "$aggregate" "$next"' EXIT
  printf '[]\n' > "$aggregate"
  token=""; previous_token=""; pages=0
  while :; do
    curl_rc=0
    if [[ -z "$token" ]]; then
      status="$(curl -sS --connect-timeout 15 --max-time 30 \
        'https://api.elevenlabs.io/v2/voices?page_size=100&include_total_count=false' \
        -H @/dev/fd/3 --output "$body" --write-out '%{http_code}' \
        3<<< "xi-api-key: $KEY")" || curl_rc=$?
    else
      status="$(curl -sS --connect-timeout 15 --max-time 30 --get \
        'https://api.elevenlabs.io/v2/voices' --data-urlencode page_size=100 \
        --data-urlencode include_total_count=false --data-urlencode "next_page_token=$token" \
        -H @/dev/fd/3 --output "$body" --write-out '%{http_code}' \
        3<<< "xi-api-key: $KEY")" || curl_rc=$?
    fi
    [[ $curl_rc -eq 0 && "$status" =~ ^2[0-9][0-9]$ ]] || {
      printf 'ElevenLabs: could not list voices (%s)\n' "${status:-transport error}" >&2; exit 74; }
    jq -e '.voices|type=="array"' "$body" >/dev/null 2>&1 || {
      printf 'ElevenLabs: invalid voice-list response\n' >&2; exit 74; }
    # Merge through files, not --argjson. Large accounts can have thousands
    # of voices; putting the accumulated metadata on jq's command line both
    # exposes it in the process table and eventually exceeds ARG_MAX.
    jq -s '.[0] + .[1].voices' "$aggregate" "$body" > "$next" || exit 1
    mv "$next" "$aggregate" || exit 1
    next="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-next-voices.XXXXXX")" || exit 1
    pages=$((pages + 1))
    jq -e '.has_more == true' "$body" >/dev/null 2>&1 || break
    token="$(jq -r '.next_page_token // empty' "$body")"
    [[ -n "$token" && "$token" != "$previous_token" && $pages -lt 100 ]] || {
      printf 'ElevenLabs: invalid voice-list pagination\n' >&2; exit 74; }
    previous_token="$token"
  done
  # A cloned voice is worth distinguishing from a stock one; otherwise the
  # vendor's own name is what the user recognises from the website.
  jq '[.[]? | {
      value: .voice_id,
      label: (.name + (if (.category // "premade") == "premade" then "" else " · " + .category end))
    }] | map(select(.value != null and .label != null))' "$aggregate"
  exit 0
fi

if [[ "${1:-}" == "--usage" ]]; then
  body="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-usage.XXXXXX")" || exit 1
  headers="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-headers.XXXXXX")" || exit 1
  trap 'rm -f "$body" "$headers"' EXIT
  curl_rc=0
  status="$(curl -sS --connect-timeout 15 --max-time 30 \
    https://api.elevenlabs.io/v1/user/subscription -H @/dev/fd/3 \
    --dump-header "$headers" --output "$body" --write-out '%{http_code}' \
    3<<< "xi-api-key: $KEY")" || curl_rc=$?
  if [[ $curl_rc -ne 0 ]]; then cloud_transport_fail ElevenLabs "$curl_rc"; exit $?; fi
  [[ "$status" =~ ^[0-9]{3}$ ]] || { printf 'ElevenLabs: invalid HTTP response\n' >&2; exit 74; }
  [[ "$status" =~ ^2[0-9][0-9]$ ]] || { cloud_fail ElevenLabs "$status" "$body" "$headers"; exit $?; }
  account="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-account.XXXXXX")" || exit 1
  trap 'rm -f "$body" "$headers" "$account"' EXIT
  jq '{source:"provider",tier,status,used:(.character_count // 0),limit:(.character_limit // 0),
    canExtend:(.can_extend_character_limit // false),overage:(.current_overage // 0),
    resetAt:(.next_character_count_reset_unix // null)}' "$body" > "$account" || exit 1
  cloud_store_account "$account" || exit 1
  cat "$account"
  exit 0
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.elevenlabs.voiceId // empty' "$TTS_CONFIG" 2>/dev/null)"
[[ -n "$VOICE" ]] || {
  printf 'ElevenLabs: no voice selected; refresh cloud voices and choose one\n' >&2
  exit 64
}
[[ "$VOICE" =~ ^[A-Za-z0-9._+-]+$ ]] || {
  printf 'ElevenLabs: invalid voice id in configuration\n' >&2
  exit 64
}

audio="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs.XXXXXX.mp3")" || exit 1
headers="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-tts-elevenlabs-headers.XXXXXX")" || exit 1
trap 'rm -f "$audio" "$headers"' EXIT
curl_rc=0
status="$(jq -Rs --arg m "$MODEL" '{text:., model_id:$m}' |
  curl -sS --connect-timeout 15 --max-time 180 \
    "https://api.elevenlabs.io/v1/text-to-speech/$VOICE?output_format=mp3_44100_128" \
    -H @/dev/fd/3 --data-binary @- --dump-header "$headers" --output "$audio" \
    --write-out '%{http_code}' \
    3<<< "xi-api-key: $KEY"$'\nContent-Type: application/json')" || curl_rc=$?
if [[ $curl_rc -ne 0 ]]; then cloud_transport_fail ElevenLabs "$curl_rc"; exit $?; fi
[[ "$status" =~ ^[0-9]{3}$ ]] || { printf 'ElevenLabs: invalid HTTP response\n' >&2; exit 74; }
cost="$(cloud_header "$headers" character-cost)"; [[ "$cost" =~ ^[0-9]+$ ]] || cost=0
cloud_record elevenlabs "$MODEL" "${TTS_INPUT_CHARS:-0}" "$status" "$headers" "$audio" "$cost"
if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then cloud_fail ElevenLabs "$status" "$audio" "$headers"; exit $?; fi
[[ -s "$audio" ]] || { printf 'ElevenLabs: service returned no audio\n' >&2; exit 74; }
play_file "$audio"
