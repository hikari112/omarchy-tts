#!/usr/bin/env bash
# desc: opt-in local, best quality, slow cold start
# kind: local
# probe: [[ -x "${KOKORO_PYTHON:-$HOME/.local/share/omarchy-tts/kokoro-venv/bin/python}" ]]
# install: uv venv ~/.local/share/omarchy-tts/kokoro-venv && uv pip install --python ~/.local/share/omarchy-tts/kokoro-venv/bin/python kokoro soundfile
# voices: bundled
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"

# Bring your own interpreter: any python with `kokoro` importable.
KPY="${KOKORO_PYTHON:-$HOME/.local/share/omarchy-tts/kokoro-venv/bin/python}"
if [[ ! -x "$KPY" ]]; then
  echo "speak: kokoro not installed." >&2
  echo "  uv venv ~/.local/share/omarchy-tts/kokoro-venv" >&2
  echo "  uv pip install --python ~/.local/share/omarchy-tts/kokoro-venv/bin/python kokoro soundfile" >&2
  notify-send -a "Speak" "Kokoro not installed" "See: speak --help" 2>/dev/null
  exit 127
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.kokoro.voice // "af_heart"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="af_heart"

TEXT="$(cat)"
KOKORO_VOICE="$VOICE" KOKORO_SPEED="${TTS_RATE:-1.0}" KOKORO_TEXT="$TEXT" \
"$KPY" - <<'PYEOF' | play_raw 24000 1
import os, sys, numpy as np
from kokoro import KPipeline
pipe = KPipeline(lang_code=os.environ.get("KOKORO_VOICE", "af_heart")[0])
for _, _, audio in pipe(os.environ["KOKORO_TEXT"],
                        voice=os.environ.get("KOKORO_VOICE", "af_heart"),
                        speed=float(os.environ.get("KOKORO_SPEED", "1.0"))):
    sys.stdout.buffer.write((np.clip(audio, -1, 1) * 32767).astype("<i2").tobytes())
    sys.stdout.buffer.flush()
PYEOF
