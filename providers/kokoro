#!/usr/bin/env bash
# desc: Best local quality. Heavy, slow to start.
# title: Kokoro
# kind: local
# probe: [[ -x "${KOKORO_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/bin/python}" ]]
# install: managed Python 3.12 venv · kokoro==0.9.4
# voices: bundled
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"

# Bring your own interpreter: any python with `kokoro` importable.
KPY="${KOKORO_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/bin/python}"
if [[ ! -x "$KPY" ]]; then
  echo "speak: kokoro not installed." >&2
  echo "  Install it from the Provider tab." >&2
  notify-send -a "Speak" "Kokoro not installed" "See: speak --help" 2>/dev/null
  exit 127
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.kokoro.voice // "af_heart"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="af_heart"

# Torch and the HF hub client are chatty on stderr on every run; none of it is
# actionable here, and it buries real errors.
KOKORO_VOICE="$VOICE" KOKORO_SPEED="${TTS_RATE:-1.0}" \
PYTHONWARNINGS=ignore HF_HUB_DISABLE_TELEMETRY=1 \
"$KPY" 3<&0 - <<'KOKORO_PY' 2>/dev/null | play_raw 24000 1
import os, sys, warnings
warnings.filterwarnings("ignore")
import numpy as np
from kokoro import KPipeline

voice = os.environ.get("KOKORO_VOICE", "af_heart")
pipe = KPipeline(lang_code=voice[0])
with os.fdopen(3, encoding="utf-8") as source:
    text = source.read()

for _, _, audio in pipe(text, voice=voice,
                        speed=float(os.environ.get("KOKORO_SPEED", "1.0"))):
    # kokoro yields a torch Tensor, which has no .astype; convert first.
    if hasattr(audio, "detach"):
        audio = audio.detach().cpu().numpy()
    samples = np.clip(np.asarray(audio, dtype="float32"), -1.0, 1.0)
    sys.stdout.buffer.write((samples * 32767.0).astype("<i2").tobytes())
    sys.stdout.buffer.flush()
KOKORO_PY
