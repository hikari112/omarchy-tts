#!/usr/bin/env bash
# desc: Best local quality. A resident worker keeps the model loaded.
# title: Kokoro
# kind: local
# probe: [[ -x "${KOKORO_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/bin/python}" && -s "${KOKORO_MODELS:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/models}/kokoro-v1_0.pth" ]] && ( [[ -n "${KOKORO_PYTHON:-}" ]] || [[ "$(cat "${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/.lock-sha256" 2>/dev/null)" == "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/kokoro.lock" | cut -d' ' -f1)" ]] )
# install: managed Python 3.12 venv from lib/engines/kokoro.lock · verified model files
# voices: bundled
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"

# Bring your own interpreter: any python with `kokoro` importable.
KPY="${KOKORO_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/bin/python}"
if [[ ! -x "$KPY" ]]; then
  echo "speak: kokoro not installed." >&2
  echo "  Install it from the Provider tab." >&2
  notify-send -a "Speak" "Kokoro not installed" "See: speak --help" 2>/dev/null
  exit 127
fi

# An environment this release did not build from its shipped lock is not
# an installed engine, whatever it contains.
if [[ -z "${KOKORO_PYTHON:-}" ]]; then
  ENGINE_DIR="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro"
  if [[ "$(cat "$ENGINE_DIR/.lock-sha256" 2>/dev/null)" != "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/kokoro.lock" | cut -d' ' -f1)" ]]; then
    echo "speak: kokoro was installed by an earlier release; reinstall it from the Provider tab." >&2
    notify-send -a "Speak" "Kokoro needs reinstalling" "Reinstall it from the Provider tab." 2>/dev/null
    exit 127
  fi
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.kokoro.voice // "af_heart"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="af_heart"

# The model, its config and the chosen voice are the files the installer
# verified against lib/engines/models.json; check them again here, right
# before they are loaded, and never let the hub client reach the network.
MODELS="${KOKORO_MODELS:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro/models}"
MANIFEST="$TTS_PLUGIN_DIR/lib/engines/models.json"
[[ "$VOICE" =~ ^[a-z]{2}_[a-z]+$ ]] || { echo "speak: kokoro: invalid voice name" >&2; exit 65; }
verify_model() { # <relative path>
  local want got
  want="$(jq -r --arg f "$1" '.kokoro.files[$f].sha256 // empty' "$MANIFEST" 2>/dev/null)"
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] || { echo "speak: kokoro: $1 is not a verified model file" >&2; exit 65; }
  [[ -f "$MODELS/$1" && ! -L "$MODELS/$1" ]] || { echo "speak: kokoro: $1 is missing; reinstall Kokoro from the Provider tab" >&2; exit 127; }
  got="$(sha256sum "$MODELS/$1" | cut -d' ' -f1)"
  [[ "$got" == "$want" ]] || { echo "speak: kokoro: $1 failed verification; reinstall Kokoro from the Provider tab" >&2; exit 65; }
}
# A live worker records the path, mtime, and size of every file it verified.
# Hashing the checkpoint again is the pause before the first word, so skip it
# only when that record still describes these exact files. Anything else,
# including a socket left by another model directory, is checked in full
# before Python starts. The worker checks again at startup.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  KOKORO_RUNTIME_DIR="${XDG_RUNTIME_DIR}/omarchy-tts/kokoro"
else
  KOKORO_RUNTIME_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-tts/kokoro"
fi
KOKORO_SOCK="$KOKORO_RUNTIME_DIR/worker.sock"
KOKORO_STAMP="$KOKORO_RUNTIME_DIR/verified.stamp"
stamp_covers() { # <relative path>
  local recorded current rec_ns rec_size cur_s cur_size
  [[ -f "$KOKORO_STAMP" && ! -L "$KOKORO_STAMP" ]] || return 1
  recorded="$(awk -v rel="$1" '$1 == "file" && $2 == rel { print $3 " " $4; exit }' "$KOKORO_STAMP")"
  current="$(stat -c '%Y %s' "$MODELS/$1" 2>/dev/null || true)"
  [[ -n "$recorded" && -n "$current" ]] || return 1
  read -r rec_ns rec_size <<<"$recorded"
  read -r cur_s cur_size <<<"$current"
  [[ "$rec_ns" =~ ^[0-9]+$ && "$rec_size" == "$cur_size" ]] || return 1
  # The stamp stores nanoseconds. The second matches when the file was not replaced.
  [[ "$((rec_ns / 1000000000))" == "$cur_s" ]] || return 1
}
models_recorded="$(awk '$1 == "models" { print substr($0, 8); exit }' "$KOKORO_STAMP" 2>/dev/null || true)"
# Skip the Kokoro rehash only when the worker stamp still matches.  A socket by itself is not proof that these model files were verified.
# The shell now checks the worker's recorded path, mtime, and size.
# Hashes the files before starting Python whenever that record does not match.
kokoro_stamp_fresh() {
  [[ -S "$KOKORO_SOCK" && ! -L "$KOKORO_SOCK" && ! -L "$KOKORO_RUNTIME_DIR" ]] || return 1
  [[ "$models_recorded" == "$MODELS" ]] || return 1
  stamp_covers config.json || return 1
  stamp_covers kokoro-v1_0.pth || return 1
  stamp_covers "voices/$VOICE.pt" || return 1
}
if ! kokoro_stamp_fresh; then
  verify_model config.json
  verify_model kokoro-v1_0.pth
  verify_model "voices/$VOICE.pt"
fi

# The worker is detached from this process group, so stopping speech does not
# unload the model. Playback stays in this pipeline and dies with the client.
export KOKORO_VOICE="$VOICE" KOKORO_SPEED="${TTS_RATE:-1.0}" KOKORO_MODELS="$MODELS"
export KOKORO_RUNTIME_DIR
export PYTHONWARNINGS=ignore HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
"$KPY" "$TTS_PLUGIN_DIR/lib/kokoro_runtime.py" | play_raw 24000 1
