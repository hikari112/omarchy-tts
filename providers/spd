#!/usr/bin/env bash
# desc: speech-dispatcher, the standard Linux a11y stack
# kind: local
# probe: command -v spd-say >/dev/null 2>&1
# install: omarchy pkg add speech-dispatcher
# voices: system
set -uo pipefail
source "$TTS_PLUGIN_DIR/lib/play.sh"
need spd-say "install with: omarchy pkg add speech-dispatcher"

RATE="$(awk -v r="${TTS_RATE:-1.0}" 'BEGIN{ v=(r-1)*100; if(v>100)v=100; if(v<-100)v=-100; printf "%d", v }')"
TEXT="$(cat)"
ARGS=(-w -r "$RATE")
[[ -n "${TTS_VOICE:-}" ]] && ARGS+=(-y "$TTS_VOICE")
if [[ "${TTS_SILENT:-0}" == "1" ]]; then
  # Speech Dispatcher has no null audio sink. Querying its live output modules
  # proves that the client can reach the daemon without queueing any speech.
  exec spd-say --list-output-modules > /dev/null
fi
exec spd-say "${ARGS[@]}" -- "$TEXT"
